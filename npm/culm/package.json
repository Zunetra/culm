    "@zunetra/culm-linux-x64": "0.0.0",
    "@zunetra/culm-linux-arm64": "0.0.0",
    "@zunetra/culm-darwin-x64": "0.0.0",
    "@zunetra/culm-darwin-arm64": "0.0.0",
    "@zunetra/culm-win32-x64": "0.0.0"
