---
import { appName } from "../config";

interface Props {
  title?: string;
}

// A page that sets no title still gets the application's, rather than rendering
// an empty one.
const { title = appName } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
