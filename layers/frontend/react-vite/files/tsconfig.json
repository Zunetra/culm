{
  "//": "Scoped to this layer's source directory rather than claiming the workspace's root tsconfig.json, which a second frontend would collide with.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@react-vite/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
